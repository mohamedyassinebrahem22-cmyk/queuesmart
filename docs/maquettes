<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maquettes QueueSmart - Complètes</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0B7F86',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
        .phone-frame { width: 390px; height: 844px; background: white; border-radius: 40px; border: 8px solid #1f2937; overflow: hidden; position: relative; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); }
        .notch { width: 120px; height: 28px; background: #1f2937; border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; position: absolute; top: 0; left: 50%; transform: translateX(-50%); z-index: 10; }
        .section-title { width: 100%; text-align: center; font-size: 20px; font-weight: 700; color: #374151; margin: 40px 0 20px; }
    </style>
</head>
<body class="p-10">

    <!-- TITRE SECTION CLIENT -->
    <h2 class="section-title">📱 Écrans principaux - Client</h2>
    <div class="flex flex-wrap gap-10 justify-center items-start">

        <!-- ÉCRAN 1 : ACCUEIL FILE -->
        <div class="phone-frame flex flex-col p-6 pt-12">
            <div class="notch"></div>
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-gray-900">Chez Sami</h1>
                <p class="text-base text-gray-500 mt-1">Coiffure</p>
            </div>
            <div class="mb-6">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">
                    <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
                    File ouverte
                </span>
            </div>
            <div class="flex justify-between mb-8">
                <div class="bg-gray-50 p-4 rounded-xl flex-1 mr-2">
                    <p class="text-2xl font-bold text-gray-900">3</p>
                    <p class="text-sm text-gray-600">personnes en attente</p>
                </div>
                <div class="bg-gray-50 p-4 rounded-xl flex-1 ml-2">
                    <p class="text-2xl font-bold text-gray-900">00:30:00</p>
                    <p class="text-sm text-gray-600">Attente estimée</p>
                </div>
            </div>
            <div class="mb-6">
                <input type="text" placeholder="Votre prénom (facultatif)" class="w-full h-12 px-4 border border-gray-300 rounded-xl text-base">
            </div>
            <button class="w-full h-12 bg-primary text-white font-semibold text-base rounded-xl shadow-md">
                Prendre un ticket
            </button>
        </div>

        <!-- ÉCRAN 2 : SUIVI TICKET -->
        <div class="phone-frame flex flex-col p-6 pt-12">
            <div class="notch"></div>
            <div class="border-2 border-dashed border-gray-300 rounded-2xl p-6 text-center mb-8 bg-gray-50">
                <p class="text-5xl font-bold text-primary mb-2">n° 4</p>
                <p class="text-xl text-gray-700">Leila</p>
            </div>
            <div class="text-center mb-8">
                <p class="text-5xl font-bold text-gray-900 tracking-tight">00:27:30</p>
                <p class="text-base text-gray-500 mt-2">Temps d'attente estimé (h : min : s)</p>
            </div>
            <div class="flex justify-between mb-6">
                <div class="bg-primary bg-opacity-10 p-4 rounded-xl flex-1 mr-2 text-center">
                    <p class="text-xl font-bold text-primary">4</p>
                    <p class="text-sm text-gray-700">Position</p>
                </div>
                <div class="bg-gray-100 p-4 rounded-xl flex-1 ml-2 text-center">
                    <p class="text-xl font-bold text-gray-700">3</p>
                    <p class="text-sm text-gray-600">Devant vous</p>
                </div>
            </div>
            <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 mb-8 flex items-start">
                <svg class="w-5 h-5 text-yellow-600 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
                <p class="text-sm text-yellow-800 font-medium">Plus que 2 personnes avant vous. Rapprochez-vous du salon.</p>
            </div>
            <button class="w-full h-12 border-2 border-gray-300 text-gray-700 font-semibold text-base rounded-xl">
                Annuler mon ticket
            </button>
        </div>

        <!-- ÉCRAN 3 : C'EST VOTRE TOUR -->
        <div class="phone-frame flex flex-col bg-green-50">
            <div class="notch" style="background: #166534;"></div>
            <div class="flex-1 flex flex-col items-center justify-center p-8 text-center">
                <div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center mb-6 shadow-lg">
                    <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <h2 class="text-3xl font-bold text-green-900 mb-4">C'est votre tour !</h2>
                <p class="text-lg text-green-800 mb-8">Présentez-vous au salon.</p>
                <div class="bg-white bg-opacity-80 backdrop-blur-sm px-6 py-3 rounded-full shadow-sm">
                    <p class="text-base font-semibold text-green-900">Ticket n° 4 · Leila</p>
                </div>
            </div>
        </div>
    </div>

    <!-- TITRE SECTION BONUS -->
    <h2 class="section-title">✨ Écrans bonus - Cas particuliers</h2>
    <div class="flex flex-wrap gap-10 justify-center items-start">

        <!-- ÉCRAN BONUS 1 : CONFIRMATION D'ANNULATION (UC5) -->
        <div class="phone-frame flex flex-col p-6 pt-12">
            <div class="notch"></div>
            <!-- Fond légèrement assombri pour simuler la modale -->
            <div class="flex-1 flex flex-col justify-end pb-16">
                <!-- Modale de confirmation -->
                <div class="bg-white rounded-2xl shadow-2xl p-6 border border-gray-200">
                    <div class="w-14 h-14 bg-red-100 rounded-full flex items-center justify-center mb-4 mx-auto">
                        <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 text-center mb-2">Annuler le ticket ?</h3>
                    <p class="text-base text-gray-600 text-center mb-6">Voulez-vous vraiment annuler votre ticket n°4 ? Vous perdrez votre place dans la file.</p>
                    <button class="w-full h-12 bg-red-600 text-white font-semibold text-base rounded-xl mb-3">
                        Oui, annuler
                    </button>
                    <button class="w-full h-12 bg-gray-100 text-gray-800 font-semibold text-base rounded-xl">
                        Non, revenir
                    </button>
                </div>
            </div>
        </div>

        <!-- ÉCRAN BONUS 2 : FILE FERMÉE (UC1) -->
        <div class="phone-frame flex flex-col p-6 pt-12">
            <div class="notch"></div>
            <div class="mb-8">
                <h1 class="text-2xl font-bold text-gray-900">Chez Sami</h1>
                <p class="text-base text-gray-500 mt-1">Coiffure</p>
            </div>
            <!-- Pastille ROUGE cette fois -->
            <div class="mb-6">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-red-100 text-red-800">
                    <span class="w-2 h-2 bg-red-500 rounded-full mr-2"></span>
                    File fermée
                </span>
            </div>
            <!-- Message informatif au centre -->
            <div class="flex-1 flex flex-col items-center justify-center text-center px-4">
                <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mb-6">
                    <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h2 class="text-xl font-bold text-gray-900 mb-2">Le salon est fermé</h2>
                <p class="text-base text-gray-600 mb-2">Prochaine ouverture :</p>
                <p class="text-lg font-semibold text-primary">Demain à 09h00</p>
            </div>
            <!-- Pas de champ prénom, pas de bouton -->
            <p class="text-sm text-gray-500 text-center italic">Revenez aux horaires d'ouverture</p>
        </div>

        <!-- ÉCRAN BONUS 3 : ÉCRAN DE FIN (Ticket annulé / Absent) -->
        <div class="phone-frame flex flex-col p-6 pt-12 bg-gray-50">
            <div class="notch"></div>
            <div class="flex-1 flex flex-col items-center justify-center text-center px-6">
                <div class="w-20 h-20 bg-gray-200 rounded-full flex items-center justify-center mb-6">
                    <svg class="w-10 h-10 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-900 mb-3">Ticket annulé</h2>
                <p class="text-base text-gray-600 mb-8">Votre ticket n°4 a bien été annulé. Merci de votre visite chez Chez Sami.</p>
                
                <div class="w-full bg-white rounded-xl p-4 mb-6 border border-gray-200">
                    <p class="text-sm text-gray-500 mb-1">Récapitulatif</p>
                    <p class="text-base font-semibold text-gray-900">Ticket n°4 · Leila</p>
                    <p class="text-sm text-gray-600 mt-1">Statut : Annulé</p>
                </div>

                <button class="w-full h-12 bg-primary text-white font-semibold text-base rounded-xl shadow-md">
                    Reprendre un ticket
                </button>
            </div>
        </div>
    </div>

</body>
</html>
