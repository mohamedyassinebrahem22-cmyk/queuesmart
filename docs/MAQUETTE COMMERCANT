<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maquettes QueueSmart - Commerçant</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0B7F86',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; }
        .desktop-frame { width: 1440px; height: 1024px; background: white; border-radius: 8px; border: 2px solid #e5e7eb; overflow: hidden; position: relative; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }
        .section-title { width: 100%; text-align: center; font-size: 24px; font-weight: 700; color: #374151; margin: 60px 0 30px; }
    </style>
</head>
<body class="p-10">

    <!-- TITRE SECTION COMMERCANT -->
    <h2 class="section-title">💻 Écrans Commerçant (Desktop)</h2>
    <div class="flex flex-col gap-16 items-center">

        <!-- ÉCRAN 4 : CONNEXION -->
        <div class="desktop-frame flex items-center justify-center bg-gray-50">
            <div class="bg-white rounded-2xl shadow-xl p-12 w-96">
                <div class="text-center mb-8">
                    <h1 class="text-3xl font-bold text-primary mb-2">QueueSmart</h1>
                    <p class="text-base text-gray-600">Espace commerçant</p>
                </div>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                        <input type="email" placeholder="votre@email.com" class="w-full h-12 px-4 border border-gray-300 rounded-xl text-base focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Mot de passe</label>
                        <input type="password" placeholder="••••••••" class="w-full h-12 px-4 border border-gray-300 rounded-xl text-base focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    
                    <!-- Message d'erreur (optionnel) -->
                    <div class="bg-red-50 border border-red-200 rounded-xl p-3 text-sm text-red-700">
                        Email ou mot de passe incorrect
                    </div>
                    
                    <button class="w-full h-12 bg-primary text-white font-semibold text-base rounded-xl shadow-md hover:bg-opacity-90 transition">
                        Se connecter
                    </button>
                </div>
                
                <p class="text-center text-sm text-gray-600 mt-6">
                    Pas encore de compte ? <a href="#" class="text-primary font-semibold hover:underline">S'inscrire</a>
                </p>
            </div>
        </div>

        <!-- ÉCRAN 5 : INSCRIPTION -->
        <div class="desktop-frame flex items-center justify-center bg-gray-50">
            <div class="bg-white rounded-2xl shadow-xl p-12 w-96">
                <div class="text-center mb-8">
                    <h1 class="text-3xl font-bold text-primary mb-2">QueueSmart</h1>
                    <p class="text-base text-gray-600">Créer un compte</p>
                </div>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Nom du commerce</label>
                        <input type="text" placeholder="Ex: Chez Sami" class="w-full h-12 px-4 border border-gray-300 rounded-xl text-base focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Adresse</label>
                        <input type="text" placeholder="123 Rue Example, Ville" class="w-full h-12 px-4 border border-gray-300 rounded-xl text-base focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                        <input type="email" placeholder="votre@email.com" class="w-full h-12 px-4 border border-gray-300 rounded-xl text-base focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Mot de passe</label>
                        <input type="password" placeholder="••••••••" class="w-full h-12 px-4 border border-gray-300 rounded-xl text-base focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    
                    <button class="w-full h-12 bg-primary text-white font-semibold text-base rounded-xl shadow-md hover:bg-opacity-90 transition">
                        Créer mon compte
                    </button>
                </div>
                
                <p class="text-center text-sm text-gray-600 mt-6">
                    Déjà un compte ? <a href="#" class="text-primary font-semibold hover:underline">Se connecter</a>
                </p>
            </div>
        </div>

        <!-- ÉCRAN 6 : CRÉER LA FILE -->
        <div class="desktop-frame flex items-center justify-center bg-gray-50">
            <div class="bg-white rounded-2xl shadow-xl p-12 w-[500px]">
                <h1 class="text-3xl font-bold text-gray-900 mb-8">Créer votre file</h1>
                
                <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Nom du service</label>
                        <input type="text" placeholder="Ex: Coiffure" class="w-full h-12 px-4 border border-gray-300 rounded-xl text-base focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Durée moyenne de départ (minutes)</label>
                        <input type="number" value="10" class="w-full h-12 px-4 border border-gray-300 rounded-xl text-base focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                        <p class="text-sm text-gray-500 mt-2">Cette durée sera corrigée automatiquement après chaque client servi.</p>
                    </div>
                    
                    <button class="w-full h-12 bg-primary text-white font-semibold text-base rounded-xl shadow-md hover:bg-opacity-90 transition mt-8">
                        Créer la file
                    </button>
                </div>
            </div>
        </div>

        <!-- ÉCRAN 7 : TABLEAU DE BORD -->
        <div class="desktop-frame flex flex-col bg-gray-50">
            <!-- Barre de navigation -->
            <div class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between">
                <div class="flex items-center gap-6">
                    <h1 class="text-xl font-bold text-gray-900">Chez Sami · Coiffure</h1>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">
                        <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
                        File ouverte
                    </span>
                </div>
                <div class="flex items-center gap-6">
                    <a href="#" class="text-primary font-semibold">Tableau de bord</a>
                    <a href="#" class="text-gray-600 hover:text-primary">Statistiques</a>
                    <button class="px-4 py-2 bg-red-100 text-red-700 font-semibold text-sm rounded-xl hover:bg-red-200 transition">
                        Fermer la file
                    </button>
                </div>
            </div>

            <!-- Contenu principal -->
            <div class="flex-1 p-8 overflow-auto">
                <!-- Cartes de statistiques -->
                <div class="grid grid-cols-3 gap-6 mb-8">
                    <div class="bg-white rounded-2xl p-6 shadow-sm">
                        <p class="text-sm text-gray-600 mb-2">En attente</p>
                        <p class="text-4xl font-bold text-primary">3</p>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm">
                        <p class="text-sm text-gray-600 mb-2">Servis aujourd'hui</p>
                        <p class="text-4xl font-bold text-green-600">5</p>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm">
                        <p class="text-sm text-gray-600 mb-2">Durée moyenne</p>
                        <p class="text-4xl font-bold text-gray-900">00:12:30</p>
                    </div>
                </div>

                <!-- Bandeau service en cours -->
                <div class="bg-yellow-50 border-2 border-yellow-300 rounded-2xl p-6 mb-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm font-semibold text-yellow-800 mb-1">Service en cours</p>
                            <p class="text-2xl font-bold text-gray-900">Ticket n° 2 · Amine</p>
                            <p class="text-lg text-gray-700 mt-1">Durée : 00:06:12</p>
                        </div>
                        <div class="flex gap-3">
                            <button class="px-6 py-3 bg-green-600 text-white font-semibold rounded-xl hover:bg-green-700 transition">
                                Servi
                            </button>
                            <button class="px-6 py-3 bg-red-600 text-white font-semibold rounded-xl hover:bg-red-700 transition">
                                Absent
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Bouton Appeler le suivant -->
                <button class="w-full h-16 bg-primary text-white font-bold text-lg rounded-2xl shadow-md hover:bg-opacity-90 transition mb-8 opacity-50 cursor-not-allowed" disabled>
                    Appeler le suivant (service en cours)
                </button>

                <!-- Tableau et QR Code -->
                <div class="grid grid-cols-3 gap-6">
                    <!-- Tableau des tickets -->
                    <div class="col-span-2 bg-white rounded-2xl shadow-sm overflow-hidden">
                        <div class="px-6 py-4 border-b border-gray-200">
                            <h2 class="text-lg font-bold text-gray-900">Liste des tickets</h2>
                        </div>
                        <table class="w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Ticket</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Client</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Statut</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Heure</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase">Durée</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                <tr>
                                    <td class="px-6 py-4 text-sm font-semibold text-gray-900">n° 6</td>
                                    <td class="px-6 py-4 text-sm text-gray-700">Fatima</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">En attente</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600">14:32</td>
                                    <td class="px-6 py-4 text-sm text-gray-600">—</td>
                                </tr>
                                <tr>
                                    <td class="px-6 py-4 text-sm font-semibold text-gray-900">n° 5</td>
                                    <td class="px-6 py-4 text-sm text-gray-700">Karim</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">En attente</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600">14:28</td>
                                    <td class="px-6 py-4 text-sm text-gray-600">—</td>
                                </tr>
                                <tr>
                                    <td class="px-6 py-4 text-sm font-semibold text-gray-900">n° 4</td>
                                    <td class="px-6 py-4 text-sm text-gray-700">Leila</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">En attente</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600">14:25</td>
                                    <td class="px-6 py-4 text-sm text-gray-600">—</td>
                                </tr>
                                <tr class="bg-yellow-50">
                                    <td class="px-6 py-4 text-sm font-semibold text-gray-900">n° 2</td>
                                    <td class="px-6 py-4 text-sm text-gray-700">Amine</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">Appelé</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600">14:15</td>
                                    <td class="px-6 py-4 text-sm text-gray-600">00:06:12</td>
                                </tr>
                                <tr>
                                    <td class="px-6 py-4 text-sm font-semibold text-gray-900">n° 1</td>
                                    <td class="px-6 py-4 text-sm text-gray-700">Sara</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">Servi</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600">14:05</td>
                                    <td class="px-6 py-4 text-sm text-gray-600">00:12:30</td>
                                </tr>
                                <tr>
                                    <td class="px-6 py-4 text-sm font-semibold text-gray-900">n° 3</td>
                                    <td class="px-6 py-4 text-sm text-gray-700">Youssef</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">Absent</span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-600">14:10</td>
                                    <td class="px-6 py-4 text-sm text-gray-600">—</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Carte QR Code -->
                    <div class="bg-white rounded-2xl shadow-sm p-6">
                        <h2 class="text-lg font-bold text-gray-900 mb-4">QR Code</h2>
                        <div class="bg-gray-100 rounded-xl p-8 mb-4 flex items-center justify-center">
                            <div class="w-48 h-48 bg-white border-4 border-gray-300 rounded-lg flex items-center justify-center">
                                <p class="text-gray-400 text-sm">QR Code ici</p>
                            </div>
                        </div>
                        <p class="text-sm text-gray-600 mb-4">Affichez-le dans votre commerce pour que les clients scannent et prennent un ticket.</p>
                        <div class="space-y-2">
                            <button class="w-full h-10 bg-primary text-white font-semibold text-sm rounded-xl hover:bg-opacity-90 transition">
                                Télécharger
                            </button>
                            <button class="w-full h-10 border-2 border-gray-300 text-gray-700 font-semibold text-sm rounded-xl hover:bg-gray-50 transition">
                                Imprimer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ÉCRAN 8 : STATISTIQUES -->
        <div class="desktop-frame flex flex-col bg-gray-50">
            <!-- Barre de navigation -->
            <div class="bg-white border-b border-gray-200 px-8 py-4 flex items-center justify-between">
                <div class="flex items-center gap-6">
                    <h1 class="text-xl font-bold text-gray-900">Chez Sami · Coiffure</h1>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">
                        <span class="w-2 h-2 bg-green-500 rounded-full mr-2"></span>
                        File ouverte
                    </span>
                </div>
                <div class="flex items-center gap-6">
                    <a href="#" class="text-gray-600 hover:text-primary">Tableau de bord</a>
                    <a href="#" class="text-primary font-semibold">Statistiques</a>
                    <button class="px-4 py-2 bg-red-100 text-red-700 font-semibold text-sm rounded-xl hover:bg-red-200 transition">
                        Fermer la file
                    </button>
                </div>
            </div>

            <!-- Contenu principal -->
            <div class="flex-1 p-8 overflow-auto">
                <!-- Titre et sélection de période -->
                <div class="flex items-center justify-between mb-8">
                    <h1 class="text-3xl font-bold text-gray-900">Statistiques</h1>
                    <div class="flex gap-2">
                        <button class="px-4 py-2 bg-primary text-white font-semibold text-sm rounded-xl">
                            Aujourd'hui
                        </button>
                        <button class="px-4 py-2 bg-white text-gray-700 font-semibold text-sm rounded-xl border border-gray-300 hover:bg-gray-50">
                            7 jours
                        </button>
                        <button class="px-4 py-2 bg-white text-gray-700 font-semibold text-sm rounded-xl border border-gray-300 hover:bg-gray-50">
                            30 jours
                        </button>
                    </div>
                </div>

                <!-- Cartes de statistiques -->
                <div class="grid grid-cols-4 gap-6 mb-8">
                    <div class="bg-white rounded-2xl p-6 shadow-sm">
                        <p class="text-sm text-gray-600 mb-2">Clients servis</p>
                        <p class="text-4xl font-bold text-green-600">24</p>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm">
                        <p class="text-sm text-gray-600 mb-2">Absents et annulations</p>
                        <p class="text-4xl font-bold text-red-600">3</p>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm">
                        <p class="text-sm text-gray-600 mb-2">Temps d'attente moyen</p>
                        <p class="text-4xl font-bold text-primary">18 min</p>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm">
                        <p class="text-sm text-gray-600 mb-2">Durée moyenne de service</p>
                        <p class="text-4xl font-bold text-gray-900">12 min</p>
                    </div>
                </div>

                <!-- Graphique en barres -->
                <div class="bg-white rounded-2xl shadow-sm p-6">
                    <h2 class="text-lg font-bold text-gray-900 mb-6">Clients par heure</h2>
                    <div class="flex items-end justify-between h-64 gap-2">
                        <div class="flex-1 flex flex-col items-center">
                            <div class="w-full bg-primary rounded-t-lg" style="height: 20%;"></div>
                            <p class="text-xs text-gray-600 mt-2">9h</p>
                        </div>
                        <div class="flex-1 flex flex-col items-center">
                            <div class="w-full bg-primary rounded-t-lg" style="height: 45%;"></div>
                            <p class="text-xs text-gray-600 mt-2">10h</p>
                        </div>
                        <div class="flex-1 flex flex-col items-center">
                            <div class="w-full bg-primary rounded-t-lg" style="height: 70%;"></div>
                            <p class="text-xs text-gray-600 mt-2">11h</p>
                        </div>
                        <div class="flex-1 flex flex-col items-center">
                            <div class="w-full bg-primary rounded-t-lg" style="height: 90%;"></div>
                            <p class="text-xs text-gray-600 mt-2">12h</p>
                        </div>
                        <div class="flex-1 flex flex-col items-center">
                            <div class="w-full bg-primary rounded-t-lg" style="height: 60%;"></div>
                            <p class="text-xs text-gray-600 mt-2">13h</p>
                        </div>
                        <div class="flex-1 flex flex-col items-center">
                            <div class="w-full bg-primary rounded-t-lg" style="height: 80%;"></div>
                            <p class="text-xs text-gray-600 mt-2">14h</p>
                        </div>
                        <div class="flex-1 flex flex-col items-center">
                            <div class="w-full bg-primary rounded-t-lg" style="height: 50%;"></div>
                            <p class="text-xs text-gray-600 mt-2">15h</p>
                        </div>
                        <div class="flex-1 flex flex-col items-center">
                            <div class="w-full bg-primary rounded-t-lg" style="height: 30%;"></div>
                            <p class="text-xs text-gray-600 mt-2">16h</p>
                        </div>
                        <div class="flex-1 flex flex-col items-center">
                            <div class="w-full bg-primary rounded-t-lg" style="height: 15%;"></div>
                            <p class="text-xs text-gray-600 mt-2">17h</p>
                        </div>
                    </div>
                    <p class="text-sm text-gray-500 mt-4 text-center">Heures de pointe : 11h-12h et 14h</p>
                </div>
            </div>
        </div>

    </div>

</body>
</html>
